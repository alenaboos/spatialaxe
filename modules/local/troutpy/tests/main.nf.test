nextflow_process {
    name "Test Process TROUTPY"
    script "../main.nf"
    process "TROUTPY"
    config "./nextflow.config"
    tag "modules"
    tag "modules_local"
    tag "troutpy"

    test("xenium - spatialdata zarr") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test_run' ],
                    file('/lustre/groups/binfo/workspace/alena.boos/hackathon_2026/spatialdata_write_out/spatialdata/test_run/raw_bundle', checkIfExists: true)
                ]
                """
            }
        }
        then {
            assert process.success
            def report = file(process.out.report[0][1])
            assertAll(
                { assert file(process.out.spatialdata[0][1]).isDirectory() },
                { assert new File(report.toString(), 'plots/histogram_cosine_similarity.png').exists() },
                { assert new File(report.toString(), 'plots/diffusion_results.png').exists() },
                { assert new File(report.toString(), 'tables/xrna_metadata_var.csv').exists() },
                { assert snapshot(process.out.findAll { k, v -> k.startsWith('versions') }).match() }
            )
        }
    }

    test("xenium - spatialdata zarr - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [ id:'test_run' ], file('/lustre/groups/binfo/workspace/alena.boos/hackathon_2026/spatialdata_write_out/spatialdata/test_run/raw_bundle', checkIfExists: true) ]
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
